# Variables for the Docker stack (docker-compose.yml). Template for the file generated by
#   python scripts/generate-secrets.py
# which creates .env.docker with the three secrets filled in. Do NOT commit .env.docker to git.
# Usage:  docker compose --env-file .env.docker up -d --build

# --- Secrets (generated by scripts/generate-secrets.py; leave them empty here) ---------
# Django key (sessions, CSRF). At least 32 characters; the backend refuses to start with
# example values.
DJANGO_SECRET_KEY=
# Comma-separated Fernet keys: the FIRST one encrypts, ALL of them decrypt (rotation).
# If you lose it, the encrypted data (notes, messages, attachments) is unrecoverable.
FIELD_ENCRYPTION_KEYS=
POSTGRES_PASSWORD=

# --- Database --------------------------------------------------------------------
POSTGRES_DB=crm
POSTGRES_USER=crm
# Postgres container and volume. The defaults match the development environment
# (crm-db / crm_pgdata). WARNING: if you reuse the development volume, the Postgres
# password is the one it already had (changeme), NOT POSTGRES_PASSWORD; for a clean
# install use a new volume, for example PGDATA_VOLUME=crm_docker_pgdata.
DB_CONTAINER_NAME=crm-db
PGDATA_VOLUME=crm_pgdata

# --- Access --------------------------------------------------------------------------
# Host port for the proxy (published on 127.0.0.1 only). Do not use 8000/4321/8010/4338.
APP_PORT=8080
# ":80" = local HTTP. With a real domain (crm.example.com) Caddy obtains TLS on its own;
# then publish 80 and 443 (see docs/configuration.md) and set USE_HTTPS=True.
SITE_ADDRESS=:80
USE_HTTPS=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Origins from which the browser opens the app (scheme + host + port).
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Public URL of the MCP endpoint that the UI shows in Settings > Integrations. Leave it empty
# to use the origin from which you open the app (recommended). Example with your own domain:
# MCP_PUBLIC_URL=https://crm.example.com/mcp/

# --- Optional -------------------------------------------------------------------------
# Account registration. By default only the first account can be created; afterwards
# registration is closed. Uncomment and set True to allow new accounts.
# ALLOW_REGISTRATION=False
# Session lifetime in seconds (default 14 days).
SESSION_COOKIE_AGE=1209600
UVICORN_WORKERS=2
# Tag of the built images (crm-backend:<tag>, crm-frontend:<tag>).
IMAGE_TAG=local
