# Django
SECRET_KEY=change-me-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# DB — Postgres mandatory. Start the service with `docker compose up -d db`
# (compose file at the repo root). The credentials below are the ones the compose file
# sets by default — not safe for prod, dev only.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=crm
DB_USER=crm
DB_PASSWORD=changeme

# CORS — allowed origins for the frontend (Astro dev runs on 4321)
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Encryption key for EncryptedTextField / EncryptedFileField (Fernet).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER commit this value.
FIELD_ENCRYPTION_KEY=
