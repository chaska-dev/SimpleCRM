---
/**
 * /persons — full list with grid/list, search, filters and sort.
 * Data loading is client-side (PersonsListView is an island).
 */
export const prerender = false;

import AppShell from "../../layouts/AppShell.astro";
import PersonsListView from "../../components/persons/PersonsListView";
import { meSSR, needsOnboarding, readLangCookie } from "../../lib/auth-server";
import { t } from "../../i18n";

const user = await meSSR(Astro);
if (!user) return Astro.redirect("/login/");
if (needsOnboarding(user)) return Astro.redirect("/welcome/");

const lang = readLangCookie(Astro);
---

<AppShell user={user} lang={lang} title={t(lang, "person.title_plural")}>
  <PersonsListView client:load lang={lang} />
</AppShell>
