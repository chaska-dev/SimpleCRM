---
/**
 * TopBar — top bar.
 *
 * Search on the left; on the right the compact `ES | EN` language
 * selector and the user (avatar + name). Theme and accent are managed
 * from /settings/. Height h-14, aligned with the sidebar header.
 */
import type { Lang } from "../../types";
import { t } from "../../i18n";
import { Search } from "lucide-react";
import TopBarUser from "./TopBarUser";
import LangSwitcher from "./LangSwitcher";

interface Props {
  lang?: Lang;
  userName?: string | null;
  /** Profile photo URL (already resolved with getMediaUrl) or null. */
  avatarUrl?: string | null;
  /** Current brand name (sidebar_name or the app default). */
  brandName?: string | null;
}

const { lang = "es", userName, avatarUrl = null, brandName = null } = Astro.props;
const prefs = Astro.locals.prefs;
---

<header
  class="sticky top-0 z-30 flex h-14 items-center gap-4 border-b border-border bg-surface px-6"
>
  <a href="/dashboard/" class="md:hidden text-sm font-semibold no-underline text-fg" data-brand-text>
    {brandName || t(lang, "shell.app_name")}
  </a>

  <div class="relative hidden min-w-0 flex-1 sm:block">
    <Search
      className="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-fg-muted"
      aria-hidden="true"
    />
    <input
      type="search"
      name="search"
      placeholder={t(lang, "shell.search_placeholder")}
      class="neo-input max-w-md pl-9"
      aria-label={t(lang, "shell.search_placeholder")}
      autocomplete="off"
    />
  </div>

  <div class="ml-auto flex items-center gap-2">
    <LangSwitcher client:load lang={lang} />
    {
      userName && (
        <TopBarUser
          client:load
          name={userName}
          avatarUrl={avatarUrl}
          lang={lang}
          theme={prefs?.theme ?? "dark"}
          accent={prefs?.accent ?? "#db2777"}
        />
      )
    }
  </div>
</header>
