---
// Symbol (small cut, same as the favicon and the app) + wordmark from the brand kit.
// Both use currentColor: the symbol takes the accent, the wordmark the text color.
const SYMBOL =
  "M8 128 A120 120 0 0 1 248 128 A120 120 0 0 1 8 128 Z M40 128 A88 88 0 0 0 216 128 A88 88 0 0 0 40 128 Z M74 194 A54 54 0 0 1 182 194 A54 54 0 0 1 74 194 Z";
const WORDMARK =
  "M55.51 86.48A29 29 0 1 1 81.39 46.64L65.63 53A12 12 0 1 0 54.92 69.49ZM53.44 70.52A30.5 30.5 0 1 1 26.22 112.43L41.98 106.06A13.5 13.5 0 1 0 54.03 87.51ZM96 56H113V130H96ZM93.5 35A11 11 0 0 1 115.5 35A11 11 0 0 1 93.5 35ZM127 56H144V130H127ZM127 81.5A25.5 25.5 0 0 1 178 81.5L161 81.5A8.5 8.5 0 0 0 144 81.5ZM161 81.5H178V130H161ZM161 81.5A25.5 25.5 0 0 1 212 81.5L195 81.5A8.5 8.5 0 0 0 178 81.5ZM195 81.5H212V130H195ZM227 56H244V158H227ZM227 93A38.5 38.5 0 0 1 304 93A38.5 38.5 0 0 1 227 93ZM244 93A21.5 21.5 0 0 0 287 93A21.5 21.5 0 0 0 244 93ZM318 24H335V130H318ZM410.25 122.49A38.5 38.5 0 1 1 423.26 100.5L406.59 97.19A21.5 21.5 0 1 0 399.32 109.47ZM347.74 85.5H423.26V100.5H347.74ZM555.77 114.46A51.5 51.5 0 1 1 555.77 45.54L543.14 56.91A34.5 34.5 0 1 0 543.14 103.09ZM567.77 30H584.77V130H567.77ZM576.27 30H592.77V46H576.27ZM576.27 72H592.77V88H576.27ZM592.77 30A29 29 0 0 1 592.77 88L592.77 72A13 13 0 0 0 592.77 46ZM590.48 72L608.08 72L623.63 130L606.03 130ZM637.63 30H654.63V130H637.63ZM711.51 30H728.51V130H711.51ZM637.63 30L655.72 30L692.11 130L674.02 130ZM710.42 30L728.51 30L692.11 130L674.02 130Z";
interface Props {
  name: string;
  /** "wordmark" renders only the wordmark (footer close), sized by CSS. */
  only?: "wordmark";
}
const { name, only } = Astro.props;
---

{
  only === "wordmark" ? (
    <svg class="wordmark-big" viewBox="0 0 760 182" role="img" aria-label={name} focusable="false">
      <path fill="currentColor" d={WORDMARK} />
    </svg>
  ) : (
    <span class="logo" role="img" aria-label={name}>
      <svg class="logo-mark" viewBox="0 0 256 256" width="28" height="28" aria-hidden="true" focusable="false">
        <path fill="currentColor" d={SYMBOL} />
      </svg>
      <svg class="logo-word" viewBox="0 0 760 182" width="117" height="28" aria-hidden="true" focusable="false">
        <path fill="currentColor" d={WORDMARK} />
      </svg>
    </span>
  )
}
